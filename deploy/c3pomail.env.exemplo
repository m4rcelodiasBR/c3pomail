# ============================================
# c3pomail.env.exemplo — Modelo de Variáveis de Ambiente
# ============================================
# ATENÇÃO: Este arquivo é apenas um modelo.
# Copie para /opt/c3pomail/c3pomail.env e preencha com os dados reais.
# NUNCA versione o arquivo .env real no Git!
# ============================================

# --- Servidor SMTP ---
SMTP_HOST=smtp.seu-servidor.com.br
SMTP_PORT=587
SMTP_USUARIO=usuario@seu-servidor.com.br
SMTP_SENHA=sua-senha-segura-aqui

# --- Remetente fixo (endereço que aparece como "De:") ---
EMAIL_REMETENTE=naoresponda@seu-servidor.com.br

# --- Chave de autenticação da API ---
# Gere uma chave forte: openssl rand -hex 32
API_KEY=sua-chave-api-256-bits-aqui
